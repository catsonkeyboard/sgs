# AI 接口本地配置模板
# 复制为 ai.env（同目录）并填好即可，之后双击 run-game.bat 无需在终端敲环境变量。
# 已 export 的环境变量优先于本文件；本文件不要写引号，等号两边不要加空格。
# 以 # 开头的行是注释。密钥在 ai.env 里，请勿提交（已在 .gitignore 中）。

# ── 直连模式（最简单，密钥会进游戏进程）──────────────────────
SGS_AI_URL=https://llm.example.com/v1/responses
SGS_AI_KEY=sk-...
SGS_AI_MODEL=你的模型名
SGS_AI_REASONING=none

# ── 代理模式（推荐：密钥只进 ai_proxy.py，不进游戏）────────────
# 取消下面注释并注释掉上面的直连三行；配在 ai.env 后，跑代理的
# 终端也不需要再 export，直接 tools\ai_proxy.py 即可：
# SGS_AI_TRANSPORT=proxy
# SGS_AI_PROXY=http://127.0.0.1:8899

# ── 其他可选项（默认值见 AI启动指南.md）──────────────────────
# SGS_AI_PROTOCOL=responses
# SGS_AI_THINKING=off

# ── 联机服务端：空座交给 LLM（tools\serve.bat 同样读 ai.env）────
# SGS_NET_AI=1
